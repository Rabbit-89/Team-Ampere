{
  "ci": {
    "collect": {
      "startServerCommand": "npm run preview -- --host 127.0.0.1",
      "startServerReadyPattern": "127\\.0\\.0\\.1",
      "url": ["http://127.0.0.1:4173/"],
      "numberOfRuns": 3
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "warn",
          {
            "minScore": 0.8
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "./lhci-reports"
    }
  }
}
